# Copy to .env and change only what you need. Defaults match a local first run.

GPT_BRIDGE_HOST=127.0.0.1
GPT_BRIDGE_PORT=8000
# Kimi Code sends this as the Bearer token. It is not an OpenAI key.
GPT_BRIDGE_API_KEY=local
GPT_BRIDGE_REQUIRE_API_KEY=1
# Leave empty on a first run. When set, login, logout, chat switch, break,
# dashboard-data, and Telegram routes also require X-GPT-Bridge-Secret.
# Completions stay Bearer-only so Kimi Code can call them.
GPT_BRIDGE_INTERNAL_SECRET=

GPT_BRIDGE_CHATGPT_URL=https://chatgpt.com/
# Optional. Example: gpt-5. Leave empty to keep whatever model the browser profile last used.
GPT_BRIDGE_MODEL_SLUG=

GPT_BRIDGE_HOME=.
GPT_BRIDGE_HEADLESS=0
# launch opens a visible browser. attach connects to the visible normal Chrome
# started by scripts/start-normal-chrome.sh. It is localhost-only and uses 9333.
GPT_BRIDGE_BROWSER_MODE=launch
GPT_BRIDGE_CDP_URL=http://127.0.0.1:9333
# Set to chrome or msedge for a new installed-browser window. Not a stealth layer.
GPT_BRIDGE_CHANNEL=

GPT_BRIDGE_REPLY_TIMEOUT_S=240
GPT_BRIDGE_STALL_TIMEOUT_S=45
GPT_BRIDGE_STABLE_SECONDS=2
GPT_BRIDGE_LOGIN_TIMEOUT_S=600
GPT_BRIDGE_MAX_RETRIES=2
# Prompts longer than this are attached as a text file so the composer does not clip them.
GPT_BRIDGE_ATTACH_THRESHOLD=8000

# 1 only for wire-shape checks. Do not point Kimi Code at mock mode.
GPT_BRIDGE_MOCK=0
